# Copy to .env.local and fill in. .env.local is gitignored.
#
# NODE_ENV is set automatically by Next.js (`next dev` -> development,
# `next build`/`next start` -> production) - do not set it here.

# --- Supabase (production backend; see src/lib/supabase.js) ---
# Required in production always. In local dev (`next dev`) the routes
# proxied to the local ASP.NET Core API (see next.config.mjs) don't need
# these, but email/sync still writes resumes via Supabase, so set them
# for a fully working local dev environment too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local dev API override (optional) ---
# Only read when NODE_ENV=development. Points next.config.mjs's rewrites
# at the local ASP.NET Core API (cvin-api/, `dotnet run`). Defaults to
# http://localhost:5281 if unset.
# LOCAL_API_URL=http://localhost:5281

# --- Gemini (resume analysis: src/lib/ai-analyzer.js, api/analyze, api/status/ai) ---
# Used in every environment, including local dev - there is no local
# equivalent for this.
GEMINI_API_KEY=

# --- Email inbox sync (IMAP: api/email/sync/route.js) ---
# Used in every environment, including local dev - there is no local
# equivalent for this. Leave unset to just disable the "Sync Inbox" feature.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_TLS=true
